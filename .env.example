# Copy to .env.local for local runs; set the same keys in Vercel for production.
# Never commit real values (.env*.local is gitignored).

# --- Private vault (/alchemy-vault) -----------------------------------------
ADMIN_USERNAME=Alchemy Labs
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=   # 32+ random chars: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"

# --- Brief + newsletter email (pick ONE; with none set, FormSubmit is used) --
# Gmail: Google Account > Security > 2-Step Verification > App passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# or Resend (resend.com): verify alchemylabs.in, then
RESEND_API_KEY=
RESEND_FROM=Alchemy Labs <studio@alchemylabs.in>
# recipients (defaults shown)
NOTIFY_TO=aashrithgade5@gmail.com
NOTIFY_CC=alchemylabs.work@gmail.com

# --- Ledger storage (lists briefs/subscribers in the vault) -----------------
# Supabase > Project Settings > API > service_role (server-only, never public)
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments ----------------------------------------------------------------
NEXT_PUBLIC_CARD_PAYMENT_URL=   # Razorpay Payment Page / Payment Link (https://rzp.io/...)
NEXT_PUBLIC_INTL_PAYMENT_URL=   # Razorpay International, Stripe Payment Link or paypal.me

# --- Search Console (optional, only for HTML-tag verification) --------------
NEXT_PUBLIC_GSC_VERIFICATION=
